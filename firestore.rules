rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is root/authorized admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'toonisra33@gmail.com' ||
        request.auth.token.email == 'admin@locallink.app' ||
        request.auth.token.email == 'admin@localhub.app' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny catch-all for unknown paths
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users collection (Personal Profile & Data)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // User sessions & Login history (Access logs)
    match /user_sessions/{sessionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admins registry
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Broadcasts collection (Official PR from admins)
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alerts collection (Emergency & Community alerts)
    match /alerts/{alertId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Posts (Community posts, Photos, Videos, Check-ins)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());

      // Nested comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      }
    }

    // Products (Community Marketplace)
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.sellerUid == request.auth.uid || isAdmin());
    }

    // Contact Requests (Direct messages to admin)
    match /contact_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
