{
  "rules": {
    "users": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $userId || root.child('admins').child(auth.uid).exists())",
        "role": {
          ".validate": "newData.val() == 'user' || (newData.val() == 'admin' && (auth.token.email == 'toonisra33@gmail.com' || auth.token.email == 'admin@locallink.app'))"
        }
      }
    },
    "broadcasts": {
      ".read": true,
      ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || auth.token.email == 'toonisra33@gmail.com' || auth.token.email == 'admin@locallink.app')"
    },
    "alerts": {
      ".read": true,
      ".write": "auth != null"
    },
    "posts": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
